[Unit]
Description=Sermon Clip media worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5m
StartLimitBurst=4

[Service]
Type=simple
User=sermonclip
Group=sermonclip
WorkingDirectory=/opt/sermonclip/current
EnvironmentFile=/etc/sermonclip/worker.env
Environment=NODE_ENV=production
Environment=MEDIA_WORKER_ID=%H-media-01
# This legacy worker must remain disabled unless explicitly approved. The staged
# orchestration worker is the pilot default and prevents competing consumers.
ConditionPathExists=/etc/sermonclip/enable-legacy-media-worker
ExecStart=/usr/bin/npm run worker:media
Restart=on-failure
RestartSec=15
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/sermonclip /var/log/sermonclip
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
